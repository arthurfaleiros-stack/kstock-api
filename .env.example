# Servidor
PORT=3000
NODE_ENV=development

# URL da Aplicação Frontend
FRONTEND_URL=http://localhost:5173

# Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senai@604
DB_NAME=kstock_db
DB_CONNECTION_LIMIT=10

# Autenticação JWT
JWT_SECRET=sua_chave_secreta_super_segura_kstock_2026
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Configurações de E-mail (SMTP)
# Caso não configure, a API usará o simulador automático em desenvolvimento (Ethereal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_16_digitos
SMTP_FROM="KeepStock <nao-responda@keepstock.com.br>"
